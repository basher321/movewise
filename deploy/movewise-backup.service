# Daily backup (B12), started by movewise-backup.timer. Runs as the postgres system user so
# pg_dump signs in the local way (no password file). postgres must be in the movewise group to
# read the storage folder (docs/INSTALL.md, step "Backups").

[Unit]
Description=Movewise backup (database and storage folder)
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
Environment=BACKUP_ROOT=/var/backups/movewise
Environment=DB_NAME=movewise
Environment=STORAGE_DIR=/opt/movewise/storage
ExecStart=/bin/bash /opt/movewise/deploy/backup.sh
